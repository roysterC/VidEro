{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint (full RealVisXL V5.0, not Lightning)"
    },
    "inputs": {
      "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Hero face (file in ComfyUI/input)"
    },
    "inputs": {
      "image": "hero_alisa.png"
    }
  },
  "13": {
    "class_type": "PrepImageForClipVision",
    "_meta": {
      "title": "Square-crop the hero from the top so the face, not the chest, is what IPAdapter sees"
    },
    "inputs": {
      "image": [
        "2",
        0
      ],
      "interpolation": "LANCZOS",
      "crop_position": "top",
      "sharpening": 0.0
    }
  },
  "3": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": {
      "title": "IPAdapter Unified Loader"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "preset": "PLUS FACE (portraits)"
    }
  },
  "4": {
    "class_type": "IPAdapterAdvanced",
    "_meta": {
      "title": "IPAdapter Advanced (0.6 weight, off for the last 20% so skin texture is drawn by the model)"
    },
    "inputs": {
      "model": [
        "3",
        0
      ],
      "ipadapter": [
        "3",
        1
      ],
      "image": [
        "13",
        0
      ],
      "weight": 0.6,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 0.8,
      "embeds_scaling": "V only"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "text": "%PROMPT%",
      "clip": [
        "1",
        1
      ]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative (+ the eye/face terms RealVisXL's model card recommends)"
    },
    "inputs": {
      "text": "%NEGATIVE%, face asymmetry, eyes asymmetry, deformed eyes, deformed iris, cross-eyed, deformed mouth",
      "clip": [
        "1",
        1
      ]
    }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image (size set per shot by the script)"
    },
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": {
      "title": "Pass 1: composition + face. DPM++ SDE Karras 30 steps (model card), CFG 4"
    },
    "inputs": {
      "model": [
        "4",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "7",
        0
      ],
      "seed": 0,
      "steps": 30,
      "cfg": 4.0,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode pass 1"
    },
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "14": {
    "class_type": "UpscaleModelLoader",
    "_meta": {
      "title": "Upscale model (NMKD family, natural on skin)"
    },
    "inputs": {
      "model_name": "4x_NMKD-Siax_200k.pth"
    }
  },
  "15": {
    "class_type": "ImageUpscaleWithModel",
    "_meta": {
      "title": "Upscale 4x in pixel space (no blocky latent upscale)"
    },
    "inputs": {
      "upscale_model": [
        "14",
        0
      ],
      "image": [
        "9",
        0
      ]
    }
  },
  "16": {
    "class_type": "ImageScaleBy",
    "_meta": {
      "title": "Back down to 1.5x of the base size"
    },
    "inputs": {
      "image": [
        "15",
        0
      ],
      "upscale_method": "lanczos",
      "scale_by": 0.375
    }
  },
  "17": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode for pass 2"
    },
    "inputs": {
      "pixels": [
        "16",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "12": {
    "class_type": "KSampler",
    "_meta": {
      "title": "Pass 2: hires detail. Plain model, DPM++ 2M Karras 25 steps, denoise 0.3 (model card: 0.1-0.3)"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "17",
        0
      ],
      "seed": 0,
      "steps": 25,
      "cfg": 4.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.3
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode pass 2"
    },
    "inputs": {
      "samples": [
        "12",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "19": {
    "class_type": "UltralyticsDetectorProvider",
    "_meta": {
      "title": "Face detector"
    },
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    }
  },
  "20": {
    "class_type": "FaceDetailer",
    "_meta": {
      "title": "FaceDetailer: re-render the face at up to 1024 px (fixes eyes, irises, teeth)"
    },
    "inputs": {
      "image": [
        "18",
        0
      ],
      "model": [
        "1",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "vae": [
        "1",
        2
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "bbox_detector": [
        "19",
        0
      ],
      "guide_size": 768,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": 0,
      "steps": 25,
      "cfg": 4.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.4,
      "feather": 8,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "wildcard": "",
      "cycle": 1
    }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    },
    "inputs": {
      "images": [
        "20",
        0
      ],
      "filename_prefix": "faceref"
    }
  }
}
